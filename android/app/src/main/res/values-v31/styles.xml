<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ sistem açılış ekranı API'si: zemin ve ikon uygulamanınkiyle
     aynı olsun ki açılışta renk sıçraması olmasın. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/launch_background_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/launch_background_light</item>
    </style>
</resources>
