<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  VARSAYILAN haklar — ÜCRETSİZ Apple kimliğiyle de imzalanabilir.

  Burada yalnız Keychain var. HealthKit BİLEREK yok: ücretsiz Apple
  kimliğiyle oluşturulan provizyon profilleri HealthKit yeteneğini
  TAŞIYAMAZ ve bu hak dosyada durursa imzalama "Provisioning profile
  doesn't support the HealthKit capability" hatasıyla başarısız olur —
  yani uygulama telefona hiç kurulamaz.

  Apple Developer üyeliği alındığında HealthKit için
  Runner-AppStore.entitlements kullanılır (TestFlight hattı zaten onu
  kullanıyor, bkz. .github/workflows/release.yml).
-->
<plist version="1.0">
<dict>
	<!-- Keychain erişimi.
	     flutter_secure_storage veritabanı şifreleme anahtarını ve Claude
	     API anahtarını Keychain'de tutar. Bu hak olmadan iOS, Keychain
	     çağrılarını -34018 (A required entitlement is not present) ile
	     reddeder; uygulama da şifresiz yazmaktansa durur. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bobrekdostu.bobrekDostu</string>
	</array>
</dict>
</plist>
